# Eco Tycoon Environment Variables
# Copy to .env and modify as needed

# Model Configuration
ECO_DEMO_ROWS=50000
ECO_RF_TREES=600
ECO_RF_DEPTH=20
ECO_XGB_TREES=800
ECO_XGB_DEPTH=8
ECO_XGB_LR=0.05

# GBIF Configuration
GBIF_API_BASE=https://api.gbif.org/v1
GBIF_DEFAULT_LIMIT=5000
GBIF_TIMEOUT=30

# Earth Engine (optional)
# GEE_PROJECT_ID=your-gee-project-id
# GEE_CREDENTIALS_PATH=path/to/service-account.json

# Database
DUCKDB_PATH=ecotycoon.duckdb

# Logging
LOG_LEVEL=INFO